import React, { useState, useEffect } from 'react';
import { Download, Plus, Trash2, Save, TrendingUp, Package, DollarSign, Users, Calendar } from 'lucide-react';

const ColdStoreERP = () => {
  const [activeSheet, setActiveSheet] = useState('Dashboard');
  const [currentMonth, setCurrentMonth] = useState('January');
  const [inventory, setInventory] = useState({});
  const [vendors, setVendors] = useState(['Vendor A', 'Vendor B', 'Vendor C']);
  const [itemTypes, setItemTypes] = useState(['Beef', 'Chicken', 'Pork', 'Lamb', 'Fish']);
  
  // Initialize inventory for all months
  useEffect(() => {
    const months = ['January', 'February', 'March', 'April', 'May', 'June', 
                    'July', 'August', 'September', 'October', 'November', 'December'];
    const initialInventory = {};
    months.forEach(month => {
      if (!inventory[month]) {
        initialInventory[month] = [];
      }
    });
    if (Object.keys(inventory).length === 0) {
      setInventory(initialInventory);
    }
  }, []);

  // Sample data for demonstration
  useEffect(() => {
    if (Object.keys(inventory).length === 0) return;
    
    const sampleData = {
      'January': [
        { id: 1, date: '2025-01-05', item: 'Beef', weight: 500, quantity: 20, receivedBy: 'John Doe', receivedFrom: 'Vendor A', storageDays: 15, dispatchDate: '2025-01-20', amountPaid: 7500 },
        { id: 2, date: '2025-01-12', item: 'Chicken', weight: 300, quantity: 30, receivedBy: 'Jane Smith', receivedFrom: 'Vendor B', storageDays: 10, dispatchDate: '2025-01-22', amountPaid: 3000 },
        { id: 3, date: '2025-01-18', item: 'Pork', weight: 400, quantity: 25, receivedBy: 'John Doe', receivedFrom: 'Vendor C', storageDays: 12, dispatchDate: '', amountPaid: 0 }
      ],
      'February': [
        { id: 1, date: '2025-02-03', item: 'Lamb', weight: 350, quantity: 15, receivedBy: 'Jane Smith', receivedFrom: 'Vendor A', storageDays: 8, dispatchDate: '2025-02-11', amountPaid: 2800 },
        { id: 2, date: '2025-02-15', item: 'Fish', weight: 200, quantity: 40, receivedBy: 'John Doe', receivedFrom: 'Vendor B', storageDays: 5, dispatchDate: '2025-02-20', amountPaid: 1000 }
      ]
    };
    
    setInventory(prev => ({ ...prev, ...sampleData }));
  }, []);

  const months = ['January', 'February', 'March', 'April', 'May', 'June', 
                  'July', 'August', 'September', 'October', 'November', 'December'];

  // Calculate KPIs
  const calculateKPIs = () => {
    let totalWeight = 0;
    let monthRevenue = 0;
    let yearRevenue = 0;
    const activeVendorsSet = new Set();
    
    Object.entries(inventory).forEach(([month, items]) => {
      items.forEach(item => {
        if (!item.dispatchDate) {
          totalWeight += item.weight;
        }
        yearRevenue += item.amountPaid || 0;
        if (month === currentMonth) {
          monthRevenue += item.amountPaid || 0;
        }
        if (item.receivedFrom) {
          activeVendorsSet.add(item.receivedFrom);
        }
      });
    });
    
    return {
      totalWeight,
      monthRevenue,
      yearRevenue,
      activeVendors: activeVendorsSet.size
    };
  };

  // Calculate revenue by month
  const getRevenueByMonth = () => {
    return months.map(month => ({
      month: month.substring(0, 3),
      revenue: (inventory[month] || []).reduce((sum, item) => sum + (item.amountPaid || 0), 0)
    }));
  };

  // Calculate top vendors
  const getTopVendors = () => {
    const vendorRevenue = {};
    Object.values(inventory).flat().forEach(item => {
      if (item.receivedFrom) {
        vendorRevenue[item.receivedFrom] = (vendorRevenue[item.receivedFrom] || 0) + (item.amountPaid || 0);
      }
    });
    return Object.entries(vendorRevenue)
      .sort(([, a], [, b]) => b - a)
      .slice(0, 5)
      .map(([vendor, revenue]) => ({ vendor, revenue }));
  };

  // Calculate weight by item
  const getWeightByItem = () => {
    const itemWeight = {};
    Object.values(inventory).flat().forEach(item => {
      if (!item.dispatchDate) {
        itemWeight[item.item] = (itemWeight[item.item] || 0) + item.weight;
      }
    });
    return Object.entries(itemWeight).map(([item, weight]) => ({ item, weight }));
  };

  const addNewEntry = () => {
    const monthData = inventory[currentMonth] || [];
    const newEntry = {
      id: Date.now(),
      date: new Date().toISOString().split('T')[0],
      item: '',
      weight: 0,
      quantity: 0,
      receivedBy: '',
      receivedFrom: '',
      storageDays: 0,
      dispatchDate: '',
      amountPaid: 0
    };
    setInventory({
      ...inventory,
      [currentMonth]: [...monthData, newEntry]
    });
  };

  const deleteEntry = (id) => {
    setInventory({
      ...inventory,
      [currentMonth]: (inventory[currentMonth] || []).filter(entry => entry.id !== id)
    });
  };

  const updateEntry = (id, field, value) => {
    setInventory({
      ...inventory,
      [currentMonth]: (inventory[currentMonth] || []).map(entry => 
        entry.id === id ? { ...entry, [field]: value } : entry
      )
    });
  };

  const exportToExcel = () => {
    alert('Excel export functionality would generate a .xlsx file with all sheets, formulas, and VBA macros. In a production environment, this would use a library like SheetJS (XLSX) to create the actual Excel file with multiple worksheets, conditional formatting, and embedded macros.');
  };

  const kpis = calculateKPIs();
  const revenueByMonth = getRevenueByMonth();
  const topVendors = getTopVendors();
  const weightByItem = getWeightByItem();

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header */}
      <div className="bg-gradient-to-r from-blue-600 to-blue-800 text-white p-6 shadow-lg">
        <div className="max-w-7xl mx-auto">
          <h1 className="text-3xl font-bold mb-2">Cold Store Inventory ERP</h1>
          <p className="text-blue-100">Professional Meat Storage Management System</p>
        </div>
      </div>

      {/* Navigation Tabs */}
      <div className="bg-white shadow-md border-b">
        <div className="max-w-7xl mx-auto px-6">
          <div className="flex space-x-1 overflow-x-auto">
            <button
              onClick={() => setActiveSheet('Dashboard')}
              className={`px-4 py-3 font-medium transition-colors ${
                activeSheet === 'Dashboard'
                  ? 'bg-blue-600 text-white'
                  : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
              }`}
            >
              Dashboard
            </button>
            {months.map(month => (
              <button
                key={month}
                onClick={() => {
                  setActiveSheet('Monthly');
                  setCurrentMonth(month);
                }}
                className={`px-4 py-3 font-medium transition-colors whitespace-nowrap ${
                  activeSheet === 'Monthly' && currentMonth === month
                    ? 'bg-blue-600 text-white'
                    : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                }`}
              >
                {month}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto p-6">
        {/* Dashboard View */}
        {activeSheet === 'Dashboard' && (
          <div className="space-y-6">
            {/* KPI Cards */}
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
              <div className="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-500">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-gray-500 text-sm font-medium">Total Weight Stored</p>
                    <p className="text-3xl font-bold text-gray-800 mt-2">{kpis.totalWeight} kg</p>
                  </div>
                  <Package className="text-blue-500" size={40} />
                </div>
              </div>

              <div className="bg-white p-6 rounded-lg shadow-md border-l-4 border-green-500">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-gray-500 text-sm font-medium">Revenue (Month)</p>
                    <p className="text-3xl font-bold text-gray-800 mt-2">${kpis.monthRevenue.toLocaleString()}</p>
                  </div>
                  <DollarSign className="text-green-500" size={40} />
                </div>
              </div>

              <div className="bg-white p-6 rounded-lg shadow-md border-l-4 border-purple-500">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-gray-500 text-sm font-medium">Revenue (Year)</p>
                    <p className="text-3xl font-bold text-gray-800 mt-2">${kpis.yearRevenue.toLocaleString()}</p>
                  </div>
                  <TrendingUp className="text-purple-500" size={40} />
                </div>
              </div>

              <div className="bg-white p-6 rounded-lg shadow-md border-l-4 border-orange-500">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-gray-500 text-sm font-medium">Active Vendors</p>
                    <p className="text-3xl font-bold text-gray-800 mt-2">{kpis.activeVendors}</p>
                  </div>
                  <Users className="text-orange-500" size={40} />
                </div>
              </div>
            </div>

            {/* Charts */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              {/* Revenue by Month */}
              <div className="bg-white p-6 rounded-lg shadow-md">
                <h3 className="text-lg font-bold text-gray-800 mb-4">Revenue by Month</h3>
                <div className="space-y-2">
                  {revenueByMonth.map(({ month, revenue }) => {
                    const maxRevenue = Math.max(...revenueByMonth.map(r => r.revenue)) || 1;
                    const width = (revenue / maxRevenue) * 100;
                    return (
                      <div key={month} className="flex items-center space-x-3">
                        <span className="w-12 text-sm font-medium text-gray-600">{month}</span>
                        <div className="flex-1 bg-gray-200 rounded-full h-8 overflow-hidden">
                          <div
                            className="bg-gradient-to-r from-blue-500 to-blue-600 h-full flex items-center justify-end px-3 transition-all duration-500"
                            style={{ width: `${width}%` }}
                          >
                            <span className="text-white text-xs font-bold">${revenue.toLocaleString()}</span>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>

              {/* Top Vendors */}
              <div className="bg-white p-6 rounded-lg shadow-md">
                <h3 className="text-lg font-bold text-gray-800 mb-4">Top Vendors by Revenue</h3>
                <div className="space-y-2">
                  {topVendors.map(({ vendor, revenue }, idx) => {
                    const maxRevenue = Math.max(...topVendors.map(v => v.revenue)) || 1;
                    const width = (revenue / maxRevenue) * 100;
                    const colors = ['bg-green-500', 'bg-blue-500', 'bg-purple-500', 'bg-orange-500', 'bg-pink-500'];
                    return (
                      <div key={vendor} className="flex items-center space-x-3">
                        <span className="w-20 text-sm font-medium text-gray-600 truncate">{vendor}</span>
                        <div className="flex-1 bg-gray-200 rounded-full h-8 overflow-hidden">
                          <div
                            className={`${colors[idx % colors.length]} h-full flex items-center justify-end px-3 transition-all duration-500`}
                            style={{ width: `${width}%` }}
                          >
                            <span className="text-white text-xs font-bold">${revenue.toLocaleString()}</span>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>

            {/* Weight by Item (Pie Chart Representation) */}
            <div className="bg-white p-6 rounded-lg shadow-md">
              <h3 className="text-lg font-bold text-gray-800 mb-4">Current Storage Weight by Item Type</h3>
              <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
                {weightByItem.map(({ item, weight }) => {
                  const colors = ['bg-red-500', 'bg-yellow-500', 'bg-pink-500', 'bg-indigo-500', 'bg-teal-500'];
                  const colorIdx = itemTypes.indexOf(item) % colors.length;
                  return (
                    <div key={item} className={`${colors[colorIdx]} text-white p-4 rounded-lg text-center`}>
                      <p className="font-bold text-2xl">{weight}</p>
                      <p className="text-sm mt-1">kg</p>
                      <p className="text-xs mt-2 font-medium">{item}</p>
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Export Button */}
            <div className="flex justify-end">
              <button
                onClick={exportToExcel}
                className="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg flex items-center space-x-2 font-medium shadow-md transition-colors"
              >
                <Download size={20} />
                <span>Export to Excel</span>
              </button>
            </div>
          </div>
        )}

        {/* Monthly Data Entry View */}
        {activeSheet === 'Monthly' && (
          <div className="space-y-4">
            <div className="flex justify-between items-center mb-4">
              <h2 className="text-2xl font-bold text-gray-800">{currentMonth} 2025 - Inventory Records</h2>
              <button
                onClick={addNewEntry}
                className="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg flex items-center space-x-2 font-medium shadow-md transition-colors"
              >
                <Plus size={20} />
                <span>Add Entry</span>
              </button>
            </div>

            {/* Summary Cards */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
              <div className="bg-blue-50 p-4 rounded-lg border border-blue-200">
                <p className="text-sm text-blue-600 font-medium">Month Total</p>
                <p className="text-2xl font-bold text-blue-800">
                  ${(inventory[currentMonth] || []).reduce((sum, item) => sum + (item.amountPaid || 0), 0).toLocaleString()}
                </p>
              </div>
              <div className="bg-green-50 p-4 rounded-lg border border-green-200">
                <p className="text-sm text-green-600 font-medium">Total Entries</p>
                <p className="text-2xl font-bold text-green-800">
                  {(inventory[currentMonth] || []).length}
                </p>
              </div>
              <div className="bg-purple-50 p-4 rounded-lg border border-purple-200">
                <p className="text-sm text-purple-600 font-medium">Total Weight</p>
                <p className="text-2xl font-bold text-purple-800">
                  {(inventory[currentMonth] || []).reduce((sum, item) => sum + (item.weight || 0), 0)} kg
                </p>
              </div>
            </div>

            {/* Data Table */}
            <div className="bg-white rounded-lg shadow-md overflow-hidden">
              <div className="overflow-x-auto">
                <table className="w-full">
                  <thead className="bg-gray-800 text-white">
                    <tr>
                      <th className="px-4 py-3 text-left text-sm font-semibold">Date</th>
                      <th className="px-4 py-3 text-left text-sm font-semibold">Item</th>
                      <th className="px-4 py-3 text-left text-sm font-semibold">Weight (kg)</th>
                      <th className="px-4 py-3 text-left text-sm font-semibold">Quantity</th>
                      <th className="px-4 py-3 text-left text-sm font-semibold">Received By</th>
                      <th className="px-4 py-3 text-left text-sm font-semibold">Received From</th>
                      <th className="px-4 py-3 text-left text-sm font-semibold">Storage Days</th>
                      <th className="px-4 py-3 text-left text-sm font-semibold">Dispatch Date</th>
                      <th className="px-4 py-3 text-left text-sm font-semibold">Amount Paid</th>
                      <th className="px-4 py-3 text-center text-sm font-semibold">Actions</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-200">
                    {(inventory[currentMonth] || []).map((entry, idx) => (
                      <tr key={entry.id} className={idx % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                        <td className="px-4 py-3">
                          <input
                            type="date"
                            value={entry.date}
                            onChange={(e) => updateEntry(entry.id, 'date', e.target.value)}
                            className="border border-gray-300 rounded px-2 py-1 text-sm w-full"
                          />
                        </td>
                        <td className="px-4 py-3">
                          <select
                            value={entry.item}
                            onChange={(e) => updateEntry(entry.id, 'item', e.target.value)}
                            className="border border-gray-300 rounded px-2 py-1 text-sm w-full"
                          >
                            <option value="">Select</option>
                            {itemTypes.map(item => (
                              <option key={item} value={item}>{item}</option>
                            ))}
                          </select>
                        </td>
                        <td className="px-4 py-3">
                          <input
                            type="number"
                            value={entry.weight}
                            onChange={(e) => updateEntry(entry.id, 'weight', parseFloat(e.target.value) || 0)}
                            className="border border-gray-300 rounded px-2 py-1 text-sm w-20"
                          />
                        </td>
                        <td className="px-4 py-3">
                          <input
                            type="number"
                            value={entry.quantity}
                            onChange={(e) => updateEntry(entry.id, 'quantity', parseInt(e.target.value) || 0)}
                            className="border border-gray-300 rounded px-2 py-1 text-sm w-20"
                          />
                        </td>
                        <td className="px-4 py-3">
                          <input
                            type="text"
                            value={entry.receivedBy}
                            onChange={(e) => updateEntry(entry.id, 'receivedBy', e.target.value)}
                            className="border border-gray-300 rounded px-2 py-1 text-sm w-full"
                          />
                        </td>
                        <td className="px-4 py-3">
                          <select
                            value={entry.receivedFrom}
                            onChange={(e) => updateEntry(entry.id, 'receivedFrom', e.target.value)}
                            className="border border-gray-300 rounded px-2 py-1 text-sm w-full"
                          >
                            <option value="">Select</option>
                            {vendors.map(vendor => (
                              <option key={vendor} value={vendor}>{vendor}</option>
                            ))}
                          </select>
                        </td>
                        <td className="px-4 py-3">
                          <input
                            type="number"
                            value={entry.storageDays}
                            onChange={(e) => updateEntry(entry.id, 'storageDays', parseInt(e.target.value) || 0)}
                            className="border border-gray-300 rounded px-2 py-1 text-sm w-20"
                          />
                        </td>
                        <td className="px-4 py-3">
                          <input
                            type="date"
                            value={entry.dispatchDate}
                            onChange={(e) => updateEntry(entry.id, 'dispatchDate', e.target.value)}
                            className="border border-gray-300 rounded px-2 py-1 text-sm w-full"
                          />
                        </td>
                        <td className="px-4 py-3">
                          <input
                            type="number"
                            value={entry.amountPaid}
                            onChange={(e) => updateEntry(entry.id, 'amountPaid', parseFloat(e.target.value) || 0)}
                            className="border border-gray-300 rounded px-2 py-1 text-sm w-24"
                          />
                        </td>
                        <td className="px-4 py-3 text-center">
                          <button
                            onClick={() => deleteEntry(entry.id)}
                            className="text-red-600 hover:text-red-800 transition-colors"
                          >
                            <Trash2 size={18} />
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Footer */}
      <div className="bg-gray-800 text-white py-4 mt-12">
        <div className="max-w-7xl mx-auto px-6 text-center text-sm">
          <p>Cold Store ERP System v1.0 | Designed for Professional Inventory Management</p>
        </div>
      </div>
    </div>
  );
};

export default ColdStoreERP;
